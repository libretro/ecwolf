ifneq ($(DISABLE_ADLIB), 1)
	SOURCES_CXX += $(CORE_DIR)/src/dosbox/dbopl.cpp \
		$(CORE_DIR)/src/libretro/id_sd_adlib.cpp \
		$(CORE_DIR)/src/libretro/id_sd_n3dmus.cpp
else
        CFLAGS += -DDISABLE_ADLIB
        CXXFLAGS += -DDISABLE_ADLIB
endif

SOURCES_C +=
# Ogg Vorbis decoder for Ogg sound effects and music tracks: libretro-common
# rvorbis via its fixed-point s16 pipeline (Q20/Q28/Q27 integer arithmetic,
# native int16 output), preserving the bit-identical cross-platform decode
# the previous Tremor path provided, without the vendored tree.
SOURCES_C += \
	$(CORE_DIR)/src/libretro/id_sd_ogg.c \
	$(CORE_DIR)/src/libretro/libretro-common/formats/vorbis/rvorbis.c
# ecwolf.pk3 base data, embedded so the core carries it internally.
SOURCES_C += $(CORE_DIR)/src/libretro/ecwolf_pk3_data.c
SOURCES_CXX +=

# libretro-common translation units the frontend already carries.  When the
# core is statically linked into RetroArch these come from RetroArch's own
# copy; compiling our own would duplicate them.
#
# features_cpu.c is in this group for a second reason: it reaches into the
# platform SDK for its timer (3ds.h, ogc/lwp_watchdog.h, ps2sdkapi.h, wut)
# and this Makefile does not put those include paths on the command line for
# the console targets, so it cannot be built here.  Only the SIMD dispatch in
# rjpeg/encoding_deflate/encoding_crc32 calls into it, and cpu_features_get()
# resolves against RetroArch at static-link time.
ifneq ($(STATIC_LINKING),1)
SOURCES_C += \
	$(CORE_DIR)/src/libretro/libretro-common/features/features_cpu.c \
	$(CORE_DIR)/src/libretro/libretro-common/compat/compat_posix_string.c \
	$(CORE_DIR)/src/libretro/libretro-common/compat/compat_snprintf.c \
	$(CORE_DIR)/src/libretro/libretro-common/compat/compat_strl.c  \
	$(CORE_DIR)/src/libretro/libretro-common/compat/fopen_utf8.c  \
	$(CORE_DIR)/src/libretro/libretro-common/encodings/encoding_utf.c \
	$(CORE_DIR)/src/libretro/libretro-common/file/file_path.c \
	$(CORE_DIR)/src/libretro/libretro-common/file/file_path_io.c \
	$(CORE_DIR)/src/libretro/libretro-common/file/retro_dirent.c \
	$(CORE_DIR)/src/libretro/libretro-common/streams/file_stream.c \
	$(CORE_DIR)/src/libretro/libretro-common/string/stdstring.c \
	$(CORE_DIR)/src/libretro/libretro-common/time/rtime.c \
	$(CORE_DIR)/src/libretro/libretro-common/vfs/vfs_implementation.c \
	$(CORE_DIR)/src/libretro/libretro-common/vfs/vfs_hybrid.c
endif
