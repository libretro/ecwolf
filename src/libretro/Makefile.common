ifeq ($(LIBRETRO_COMM_DIR),)
LIBRETRO_COMM_DIR  = $(CORE_DIR)/src/libretro/libretro-common
endif
BZIP2_DIR   = $(CORE_DIR)/deps/bzip2

INCFLAGS   := \
	-I$(CORE_DIR) \
	-I$(CORE_DIR)/src \
	-I$(CORE_DIR)/src/g_shared \
	-I$(CORE_DIR)/src/libretro \
	-I$(CORE_DIR)/src/libretro/libretro-common/include \
	-I$(BZIP2_DIR) \

ifneq (,$(findstring msvc2003,$(platform)))
INCFLAGS += -I$(LIBRETRO_COMM_DIR)/include/compat/msvc
endif



DEPS_BZIP2  := $(BZIP2_DIR)/blocksort.c \
					$(BZIP2_DIR)/bzlib.c \
					$(BZIP2_DIR)/compress.c \
					$(BZIP2_DIR)/crctable.c \
					$(BZIP2_DIR)/decompress.c \
					$(BZIP2_DIR)/huffman.c \
					$(BZIP2_DIR)/randtable.c



SOURCES_C   := $(DEPS_BZIP2) \
	$(CORE_DIR)/src/libretro/libretro-common/formats/jpeg/rjpeg.c \
	$(CORE_DIR)/src/libretro/libretro-common/encodings/encoding_deflate.c \
	$(CORE_DIR)/src/libretro/libretro-common/encodings/encoding_crc32.c \
	$(CORE_DIR)/src/libretro/libretro-common/formats/7z/r7z_archive.c \
	$(CORE_DIR)/src/libretro/libretro-common/formats/7z/r7z_lzma.c \
	$(CORE_DIR)/src/libretro/libretro-common/formats/7z/r7z_lzma2.c \
	$(CORE_DIR)/src/libretro/libretro-common/formats/7z/r7z_lzma_stream.c \
	$(CORE_DIR)/src/libretro/libretro-common/formats/7z/r7z_bcj2.c \
	$(CORE_DIR)/src/libretro/libretro-common/formats/7z/r7z_filters.c

# libretro-common DDS decoder (rdds), backing the FDDSTexture glue.
